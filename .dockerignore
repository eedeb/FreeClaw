# Keep the build context small and free of host-specific state.

.git/
.github/

# Native Linux install artifacts — the image builds its own environment.
venv/
install.sh
update.sh
uninstall.sh

# Server-side telemetry collector — deployed to Cloudflare, never run here.
telemetry/

# Secrets and per-install config: bind-mounted at runtime, never baked in.
.env
Flask/.secret_key
Flask/.api_enabled

# Per-user instance data — bind-mounted at runtime.
Flask/static/
logs/

__pycache__/
*.pyc
.DS_Store
